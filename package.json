{
  "name": "ledgerdesk",
  "version": "0.1.0",
  "private": true,
  "description": "A grounded-answer platform over versioned knowledge corpora.",
  "type": "module",
  "engines": {
    "node": ">=22.6"
  },
  "scripts": {
    "corpus": "node --experimental-strip-types quality/gen/corpus.ts",
    "typecheck": "tsc --noEmit",
    "typecheck:app": "tsc --noEmit -p tsconfig.app.json",
    "dev": "next dev --port 3000",
    "build": "next build",
    "start": "next start --port 3000",
    "test:app": "node --test tests/app/"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "^22.7.0",
    "@types/pg": "8.23.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "tailwindcss": "4.3.3",
    "typescript": "^5.8.0"
  },
  "dependencies": {
    "next": "16.3.1",
    "pg": "8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  }
}
