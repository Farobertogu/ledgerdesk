{
  "name": "ledgerdesk",
  "version": "0.1.0",
  "private": true,
  "description": "A grounded-answer platform over versioned knowledge corpora.",
  "type": "module",
  "engines": {
    "node": ">=22.6"
  },
  "scripts": {
    "test:intake": "node ci/intake_t01_check.mjs --group contracts",
    "test:intake:preparation:unit": "node --experimental-strip-types ci/intake_preparation_check.mjs --group contracts",
    "test:intake:preparation:schema": "node --experimental-strip-types ci/intake_preparation_check.mjs --group schema",
    "test:intake:storage": "node ci/intake_t01_check.mjs --group storage",
    "test:intake:recovery": "node ci/intake_t01_check.mjs --group recovery",
    "test:intake:isolation": "node ci/intake_t01_check.mjs --group isolation",
    "test:intake:limits": "node ci/intake_t01_check.mjs --group limits",
    "test:intake:lifecycle": "node ci/intake_t01_check.mjs --group lifecycle",
    "test:intake:reception:unit": "node ci/intake_t02_check.mjs --group units",
    "test:intake:reception:service": "node ci/intake_t02_check.mjs --group runtime",
    "test:intake:reception:bounds": "node ci/intake_t02_check.mjs --group boundaries",
    "test:intake:reception:temporal": "node ci/intake_t02_check.mjs --group temporal",
    "test:intake:reception:integrity": "node ci/intake_t02_check.mjs --group integrity",
    "test:intake:reception:verification": "node ci/intake_t02_matrix.mjs --suite verification",
    "test:intake:reception:recovery": "node ci/intake_t02_matrix.mjs --suite recovery",
    "test:intake:reception:browser": "node ci/intake_t02_check.mjs --group browser",
    "test:intake:reception:lifecycle": "node ci/intake_t02_check.mjs --group phase-prototype",
    "test:intake:extraction:unit": "node --experimental-strip-types ci/intake_extraction_check.mjs --group units",
    "test:intake:extraction:schema": "node --experimental-strip-types ci/intake_extraction_check.mjs --group schema",
    "test:intake:extraction:worker": "node --experimental-strip-types ci/intake_extraction_check.mjs --group worker",
    "test:intake:extraction:service": "node --experimental-strip-types ci/intake_t02_check.mjs --group extraction",
    "test:intake:extraction:formats": "node --experimental-strip-types ci/intake_t02_check.mjs --group extraction --extraction-cases formats",
    "test:intake:extraction:temporal": "node --experimental-strip-types ci/intake_t02_check.mjs --group extraction --extraction-cases temporal",
    "test:intake:extraction:fencing": "node --experimental-strip-types ci/intake_t02_check.mjs --group extraction --extraction-cases fencing",
    "test:intake:extraction:budgets": "node --experimental-strip-types ci/intake_t02_check.mjs --group extraction --extraction-cases budgets",
    "test:intake:extraction:restart": "node --experimental-strip-types ci/intake_t02_check.mjs --group extraction --extraction-cases restart",
    "test:intake:extraction:restore": "node --experimental-strip-types ci/intake_t02_check.mjs --group extraction --extraction-cases restore",
    "test:intake:extraction:storage-recovery": "node --experimental-strip-types ci/intake_t02_check.mjs --group extraction --extraction-cases storage-recovery",
    "test:intake:extraction:semantics": "node --experimental-strip-types ci/intake_t02_check.mjs --group extraction --extraction-cases semantics",
    "test:intake:extraction:mixed": "node --experimental-strip-types ci/intake_t02_check.mjs --group extraction --extraction-cases mixed",
    "corpus": "node --experimental-strip-types quality/gen/corpus.ts",
    "typecheck": "tsc --noEmit",
    "typecheck:app": "tsc --noEmit -p tsconfig.app.json",
    "dev": "next dev --port 3000",
    "build": "next build",
    "start": "next start --port 3000",
    "test:app": "node --test tests/app/",
    "test:reading": "node --experimental-strip-types --test tests/contracts/test_material_reading.mjs tests/reading/test_T01_gate_http.mjs tests/reading/test_T01_boundaries.mjs tests/reading/test_T01_terminal_probe.mjs",
    "test:reading:http": "node tests/reading/http_preparation.mjs",
    "test:reading:viewer": "node --experimental-strip-types --test tests/reading/test_T03_reader.mjs",
    "test:reading:harness": "node --test tests/reading/test_T03_harness_guards.mjs tests/reading/test_browser_diagnostics.mjs",
    "test:reading:browser": "playwright test --config playwright.reading.config.ts",
    "test:reading:policy": "node --experimental-strip-types --test tests/reading/test_T04_policy.mjs",
    "test:reading:lifecycle": "node --test tests/reading/test_T04_lifecycle.mjs",
    "test:reading:service": "node --experimental-strip-types --test --test-concurrency=1 tests/reading/test_T04_pg.mjs",
    "test:reading:origins": "node --experimental-strip-types --test tests/reading/test_T05_origins.mjs",
    "test:reading:mutations": "node --experimental-strip-types --test tests/reading/test_T05_mutations.mjs",
    "test:reading:integration": "node --experimental-strip-types --test --test-concurrency=1 tests/reading/test_T05_integration.mjs",
    "start:reading:service": "node --experimental-strip-types ci/reading_service.mjs",
    "start:reading": "node ci/reading_start.mjs",
    "test:gateway": "node --experimental-strip-types --test --test-concurrency=1 tests/gateway/",
    "test:access": "node --experimental-strip-types --test tests/access/test_contracts.mjs tests/access/test_transport.mjs tests/access/test_boundaries_mutations.mjs tests/access/test_security.mjs",
    "test:access:browser": "node ci/access_transport_check.mjs",
    "test:access:runtime:unit": "node --experimental-strip-types --test tests/access/test_runtime_units.mjs",
    "test:access:runtime": "node ci/access_runtime_check.mjs",
    "test:access:canonical": "node --experimental-strip-types --test tests/access/test_canonical.mjs",
    "test:access:invitations": "node ci/access_runtime_check.mjs --invitations",
    "test:access:reading:unit": "node --experimental-strip-types --test tests/access/test_authorized_reading_units.mjs",
    "test:access:reading": "node ci/access_runtime_check.mjs --reading",
    "test:access:administration:unit": "node --experimental-strip-types --test tests/access/test_administration_units.mjs tests/access/test_evidence.mjs",
    "test:access:administration": "node ci/access_runtime_check.mjs --administration",
    "test:access:journey:unit": "node --experimental-strip-types --test tests/access/test_bootstrap_units.mjs",
    "test:access:journey": "node --test --test-concurrency=1 tests/access/test_runtime_packaging.mjs && node ci/access_runtime_check.mjs --journey"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "^22.7.0",
    "@types/pg": "8.23.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "tailwindcss": "4.3.3",
    "typescript": "^5.8.0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.120.0",
    "@next/env": "16.3.1",
    "@node-rs/argon2": "2.2.0",
    "next": "16.3.1",
    "pg": "8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  }
}
