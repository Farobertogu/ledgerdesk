{
  "$id": "https://capstone.local/schemas/splits.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SealedSplitManifest",
  "type": "object",
  "required": ["schema_version","run_id","built_at","builder_version",
               "input_path","input_sha256","canonical_order","seed",
               "kinds","commitment"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": "1.1"},
    "run_id":       {"type": "string", "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"},
    "built_at":     {"type": "string", "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}([.][0-9]{1,3})?Z$"},
    "builder_version": {"type": "string"},
    "input_path":   {"type": "string", "description": "Exact path of the item pool consumed."},
    "input_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "canonical_order": {"const": "sorted_by_item_id_then_shuffled",
      "description": "Explicit canonical order BEFORE shuffling. Never set, dict, glob or listdir."},
    "seed":         {"type": "integer"},
    "corpus":       {"type": "object",
      "description": "Emitted by the corpus generator: template_id per item, counts per family and per template, body hashes. The registered clan fact; carried into the seal unchanged."},
    "headroom":     {"type": "object",
      "description": "The headroom self-test report of the emitting run."},
    "manifest_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$",
      "description": "sha256 of the canonical JSON (keys sorted, no whitespace) of every field except this one."},
    "kinds": {
      "type": "object",
      "required": ["selection","report","ood","blind_label"],
      "additionalProperties": false,
      "properties": {
        "selection":   {"$ref": "#/$defs/split"},
        "report":      {"$ref": "#/$defs/split"},
        "ood":         {"$ref": "#/$defs/split"},
        "blind_label": {"$ref": "#/$defs/split"}
      },
      "allOf": [
        { "if":   { "required": ["blind_label"] },
          "then": { "properties": { "blind_label": {
                      "properties": { "item_ids": { "type": "array", "minItems": 1 } },
                      "required": ["item_ids"] } } } }
      ]
    },
    "commitment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algo","salt_commitment","member_hmac","cardinality","sealed_hash","sealed_at"],
      "properties": {
        "algo":            {"const": "HMAC-SHA256"},
        "salt_commitment": {"type": "string", "pattern": "^[a-f0-9]{64}$",
          "description": "sha256(salt). The SALT ITSELF is never written here."},
        "member_hmac":     {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "cardinality":     {"type": "integer", "minimum": 1},
        "sealed_hash":     {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "sealed_at":       {"type": "string", "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}([.][0-9]{1,3})?Z$"},
        "revealed_at":     {"type": ["string","null"], "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}([.][0-9]{1,3})?Z$"}
      }
    }
  },
  "$defs": {
    "split": {
      "type": "object",
      "additionalProperties": false,
      "required": ["n","content_sha256"],
      "properties": {
        "n":              {"type": "integer", "minimum": 1},
        "item_ids":       {"type": ["array","null"], "items": {"type": "string"}, "uniqueItems": true,
          "description": "NULL for kind=report until revealed_at. Membership is sealed, not published. For kind=blind_label it is populated at sealing: the rater has to receive the items, and what stays committed separately is the label vector."},
        "content_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$",
          "description": "The manifest seals the BODIES, not only the ids."}
      }
    }
  }
}
